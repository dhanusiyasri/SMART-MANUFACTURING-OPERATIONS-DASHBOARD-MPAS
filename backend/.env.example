# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Database Connection (Microsoft SQL Server - MPAS_DB)
DB_SERVER=DHANUSIYASRI
DB_DATABASE=MPAS_DB
DB_PORT=1433
DB_USE_WINDOWS_AUTH=true

# Optional SQL Authentication Credentials (used if DB_USE_WINDOWS_AUTH is false)
DB_USER=
DB_PASSWORD=
DB_DOMAIN=

# MSSQL Connection Pool Configuration
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=15000
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=logs
