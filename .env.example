# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Microsoft SQL Server Database Configuration
DB_USER=sa
DB_PASSWORD=YourPassword123!
DB_SERVER=localhost
DB_DATABASE=ManufacturingDB
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=15000

# Logging
LOG_LEVEL=info

# Socket.IO & Real-time settings
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
REALTIME_POLL_INTERVAL_MS=5000
